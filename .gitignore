# .gitignore - Ignore rules for Object Detector
#
# Copyright (c) 2026 Ercan Ersoy.
# This file is licensed under the MIT License.
# Written by Ercan Ersoy helped by Claude Opus 4.8.
#
# Ignores everything the build steps and the application generate or download,
# so that only the project's own source files are tracked.

# Build output and downloaded dependencies, created by build.bat and
# sources/build.bat: the compiled executable and its generated configuration,
# the ONNX Runtime assemblies and the downloaded and exported model files.
/binaries/

# NuGet packages downloaded and extracted by sources/fetch-deps.ps1.
/sources/packages/

# Model weights and exported models, wherever they might be written.
*.pt
*.onnx

# Configuration file written by the application at run time.
settings.ini

# Byte-code cache produced by the Python model-export script.
__pycache__/
*.pyc
